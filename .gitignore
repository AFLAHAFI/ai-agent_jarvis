# ── MARK LVI — .gitignore ───────────────────────────────────────────────────

# ── Secrets & Credentials (NEVER COMMIT) ──────────────────────────────────────
api_keys.json
*/api_keys.json
config/api_keys.json
config/certs/
config/whatsapp_web/
**/token*.json
**/client_secret*.json
*credentials*.json
.env
.env.*

# ── Personal Data & Memories ─────────────────────────────────────────────────
long_term.json
*/long_term.json
memory/long_term.json
memory/*.db
*.docx
*.doc

# ── Python Build & Cache Noise ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# ── Scratch & Patch Test Files ────────────────────────────────────────────────
patch_*.py
test_*.py

# ── Virtual Environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Editors and Operating Systems ────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ── Runtime Output ───────────────────────────────────────────────────────────
*.log
logs/
downloads/
screenshots/
